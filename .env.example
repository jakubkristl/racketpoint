# Core backend
POSTGRES_URL=
JWT_SECRET=

# Public app URL used in emails and redirects
PUBLIC_APP_URL=http://localhost:5173

# Auth and account hardening
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_WEBHOOK_URL=
EMAIL_FROM=no-reply@racketpoint.bg
EMAIL_DEBUG_LOG_ONLY=true

# Admin and bootstrap safety
BOOTSTRAP_API_KEY=
BOOTSTRAP_ALLOW_IN_PRODUCTION=false
ADMIN_EMAIL=admin@racketpoint.bg
ADMIN_PASSWORD_HASH=

# Frontend safety toggles (keep disabled for production)
VITE_ENABLE_LOCAL_AUTH_FALLBACK=false
VITE_ENABLE_CLIENT_BOOTSTRAP=false
VITE_ENABLE_FRONTEND_ADMIN_PASSWORD=false
VITE_BOOTSTRAP_API_KEY=
VITE_ADMIN_PASSWORD=

# BORICA payments
BORICA_TERMINAL_ID=
BORICA_PRIVATE_KEY_PEM=
BORICA_PUBLIC_KEY_PEM=
BORICA_GATE_URL=https://3dsgate.borica.bg/cgi-bin/cgi_link
BORICA_BACKREF_URL=https://racketpoint.bg/api/payments/borica/callback
BORICA_RESULT_URL=https://racketpoint.bg/payments/borica/result
BORICA_CURRENCY=EUR
BORICA_MERCHANT_ID=
BORICA_MERCHANT_NAME=Racketpoint.bg
BORICA_MERCHANT_URL=https://racketpoint.bg
