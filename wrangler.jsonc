{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "racketpoint",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-03",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// `/` is a static asset, so the worker never saw it. API routes were swallowed by the SPA fallback, so orders and onsite sales never ran.
		"run_worker_first": ["/", "/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "racketpoint-db",
			"database_id": "7a4e8be2-2ff4-4c51-a89b-c12190ab7ead"
		}
	]
}
